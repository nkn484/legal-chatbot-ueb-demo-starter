APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_DB=legal_chatbot
POSTGRES_USER=legal_chatbot
POSTGRES_PASSWORD=<SET_PRIVATELY_NOT_IN_GIT>
POSTGRES_PORT=5432
# Local-only placeholder; substitute the POSTGRES_* values above outside Git.
DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
# Docker-internal placeholder; credentials must be URL-encoded before setting this value.
DATABASE_URL_DOCKER=postgresql+asyncpg://<POSTGRES_USER>:<URL_ENCODED_POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
LLM_PROVIDER=shineshop
LLM_BASE_URL=https://api.shineshop.dev/v1
LLM_MODEL=<EXACT_MODEL_ID_FROM_SHINE_V1_MODELS>
# Preferred M02 credential variable. Keep private and outside Git.
LLM_API_KEY=<SET_PRIVATELY_NOT_IN_GIT>
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_RESPONSE_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARS=65536
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RESPONSE_BYTES=1048576
LLM_HEALTH_MAX_ATTEMPTS=2
LLM_RETRY_AFTER_MAX_SECONDS=2
ANTHROPIC_API_KEY=<NOT_REQUIRED_FOR_INITIAL_DEMO>
# M00 transitional credential variable; LLM_API_KEY takes precedence for M02.
SHINE_API_KEY=<SET_PRIVATELY_NOT_IN_GIT>
# M00 spike-only legacy variables; they are not used by the M08 Official Bot path.
ZALO_BOT_SECRET_TOKEN=<SET_PRIVATELY_NOT_IN_GIT>
ZALO_BOT_TOKEN=<SET_PRIVATELY_NOT_IN_GIT>
ZALO_BOT_WEBHOOK_URL=<SET_BY_SELECTED_WEBHOOK_TRANSPORT_NGROK_FOR_M00>
# M08 Official Zalo Bot Manager. The bot token is issued externally and entered manually.
CHANNEL_ENABLED=false
ZALO_OFFICIAL_BOT_TOKEN=<ENTER_MANUALLY_FROM_ZALO_BOT_MANAGER>
ZALO_OFFICIAL_BOT_WEBHOOK_SECRET=<SET_PRIVATELY_NOT_IN_GIT>
CHANNEL_IDENTITY_HMAC_KEY=<SET_PRIVATELY_NOT_IN_GIT>
CHANNEL_MAX_BODY_BYTES=65536
CHANNEL_MAX_OUTBOUND_CHARS=1994
CHANNEL_OUTBOUND_MAX_ATTEMPTS=1
CHANNEL_BINDING_LEASE_SECONDS=120
CHANNEL_TIMEOUT_SECONDS=30
SOURCE_REGISTRY_PATH=contracts/source-registry.json
VBQPPL_READ_MANIFEST_PATH=contracts/vbqppl-read-manifest.json
VBQPPL_MODE=rest_fallback
VBQPPL_LIVE_INGESTION_ENABLED=false
VBQPPL_REST_CONNECT_TIMEOUT_SECONDS=10
VBQPPL_REST_RESPONSE_TIMEOUT_SECONDS=30
VBQPPL_REST_MAX_RESPONSE_BYTES=2097152
VBQPPL_REST_MAX_ATTEMPTS=2
VBQPPL_REST_RETRY_MAX_SECONDS=2
VBQPPL_SOAP_CONNECT_TIMEOUT_SECONDS=10
VBQPPL_SOAP_RESPONSE_TIMEOUT_SECONDS=30
VBQPPL_SOAP_MAX_RESPONSE_BYTES=2097152
VBQPPL_SOAP_TLS_VERIFY=true
RETRIEVAL_TOP_K=8
RETRIEVAL_PLANNER_ENABLED=false
RETRIEVAL_LEXICAL_REPAIR_ENABLED=false
RETRIEVAL_SEMANTIC_HYBRID_ENABLED=false
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_METADATA_REPAIR_ENABLED=false
RETRIEVAL_QUALITY_REPAIR_ENABLED=false
RETRIEVAL_QUALITY_TITLE_SEARCH_ENABLED=false
RETRIEVAL_QUALITY_HYBRID_FUSION_ENABLED=false
RETRIEVAL_QUALITY_QUERY_PLANNER_ENABLED=false
RETRIEVAL_QUALITY_DYNAMIC_EVIDENCE_ENABLED=false
RETRIEVAL_QUALITY_REPAIR_RETRIEVAL_ENABLED=false
RETRIEVAL_QUALITY_STRATEGY=disabled
# RETRIEVAL_QUALITY_SELECTED_POOL=8
RETRIEVAL_PLANNER_MAX_INPUT_CHARS=900
RETRIEVAL_PLANNER_MAX_OUTPUT_TOKENS=96
RETRIEVAL_PLANNER_TIMEOUT_SECONDS=3
RETRIEVAL_PLANNER_MAX_EXPANSION_TERMS=4
RETRIEVAL_PLANNER_MAX_PHRASES=2
RETRIEVAL_PLANNER_MAX_QUERY_COUNT=2
CONVERSATION_RECENT_TURNS=4
CONVERSATION_ROLLING_SUMMARY_MAX_CHARS=1500
CONVERSATION_ACTIVE_TOPIC_MAX_CHARS=256
CONVERSATION_CONTEXT_MAX_CHARS=1000
CONVERSATION_REFERENCE_LIMIT=6
CONVERSATION_RETAINED_EXCHANGE_LIMIT=32
CONVERSATION_RETENTION_SECONDS=604800
CONVERSATION_PROCESSING_LEASE_SECONDS=120
INGESTION_CHUNK_MAX_CHARS=1200
INGESTION_CHUNK_OVERLAP_CHARS=200
INGESTION_HTML_NORMALIZER_VERSION=html-v1
INGESTION_LEGAL_BLOCK_VERSION=legal-block-v1
INGESTION_EMBEDDING_MODEL=local-hash-v1
INGESTION_EMBEDDING_DIMENSION=384
INGESTION_EMBEDDING_BATCH_SIZE=32
# Offline semantic embedding profile. The API does not load this model at startup.
SEMANTIC_MODEL_PATH=/models/multilingual-e5-small
SEMANTIC_BATCH_SIZE=16
SEMANTIC_THREADS=2
SEMANTIC_BACKFILL_BATCH_SIZE=16
SEMANTIC_BACKFILL_SOURCE_IDS=VBQPPL,VNU,UEB
# Offline reranker profile. It is prefetched explicitly and is inactive by default.
RERANKER_MODEL_PATH=/models/mmarco-minilm-l12-h384-int8-avx2
RERANKER_BATCH_SIZE=8
RERANKER_THREADS=2
RERANKER_CANDIDATE_MAX=8
RERANKER_QUERY_MAX_CHARS=4000
RERANKER_HYDRATED_TEXT_MAX_CHARS=2000
RERANKER_TIMEOUT_SECONDS=5.0
DEMO_CORPUS_ENABLED=false
DEMO_CORPUS_DATA_PATH=demo_data
DEMO_CORPUS_DATASET_ID=demo-data-v1
DEMO_CORPUS_RETRIEVAL_SOURCE_IDS=VBQPPL,VNU,UEB
DEMO_CORPUS_CONNECT_TIMEOUT_SECONDS=10
DEMO_CORPUS_RESPONSE_TIMEOUT_SECONDS=90
DEMO_CORPUS_PROCESSING_TIMEOUT_SECONDS=120
DEMO_CORPUS_MAX_RESPONSE_BYTES=67108864
DEMO_CORPUS_OCR_ENABLED=false
DEMO_CORPUS_OCR_EXECUTABLE=tesseract
DEMO_CORPUS_OCR_LANGUAGE=vie+eng
