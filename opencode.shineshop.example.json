{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "shell": "pwsh",
  "provider": {
    "shineshop": {
      "npm": "@ai-sdk/openai",
      "name": "SHINE SHOP",
      "options": {
        "baseURL": "https://api.shineshop.dev/v1",
        "timeout": 300000,
        "chunkTimeout": 30000
      },
      "models": {
        "__SHINE_MODEL_ID__": {"name": "SHINE Selected Model"}
      }
    }
  },
  "model": "shineshop/__SHINE_MODEL_ID__",
  "instructions": [
    "docs/00-project-charter.md",
    "docs/01-demo-scope.md",
    "docs/02-architecture.md",
    "docs/03-domain-invariants.md",
    "docs/08-development-standards.md"
  ],
  "watcher": {"ignore": [".git/**", ".venv/**", "node_modules/**", "dist/**", ".demo-run/**"]}
}
