{
  "title": "HISTORICAL_DRAFT_NOT_APPROVED Reviewed Legal Effects Import Artifact",
  "description": "Historical Gate-1 documentation-only draft. Superseded by the approved v1 contract; no production import or runtime enablement is authorized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_state",
    "artifact_id",
    "approval",
    "families",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "DRAFT_NOT_APPROVED-1"
    },
    "profile_state": {
      "const": "DOCUMENTATION_ONLY_DEFAULT_OFF"
    },
    "artifact_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "external_id",
        "snapshot_id",
        "content_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "enum": ["VBQPPL", "VNU", "UEB"]
        },
        "external_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ARTICLE", "CLAUSE", "SECTION", "PAGE", "OTHER_PINPOINT"]
        },
        "value": {
          "type": "string",
          "pattern": "^[^\\r\\n]{1,500}$",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_at",
        "submitted_by",
        "reviewer_role",
        "reviewed_at",
        "reviewed_by",
        "approver_role",
        "approved_at",
        "approved_by"
      ],
      "properties": {
        "submitted_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "submitted_by": {
          "$ref": "#/$defs/opaqueId"
        },
        "reviewer_role": {
          "const": "LEGAL_REVIEWER"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "reviewed_by": {
          "$ref": "#/$defs/opaqueId"
        },
        "approver_role": {
          "const": "LEGAL_APPROVER"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "approved_by": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "completeness", "scope_note"],
      "properties": {
        "family_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "completeness": {
          "type": "string",
          "enum": ["DECLARED_PARTIAL", "DECLARED_COMPLETE"]
        },
        "scope_note": {
          "type": "string",
          "pattern": "^[^\\r\\n]{1,500}$",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "family_id",
        "subject",
        "object",
        "relation_kind",
        "effect_state",
        "basis"
      ],
      "properties": {
        "relation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "family_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "subject": {
          "$ref": "#/$defs/endpoint"
        },
        "object": {
          "$ref": "#/$defs/endpoint"
        },
        "relation_kind": {
          "type": "string",
          "enum": ["IMPLEMENTS", "GOVERNS"]
        },
        "effect_state": {
          "const": "EFFECT_NOT_MODELED"
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "provenance_id", "locator"],
          "properties": {
            "version": {
              "$ref": "#/$defs/endpoint"
            },
            "provenance_id": {
              "$ref": "#/$defs/opaqueId"
            },
            "locator": {
              "$ref": "#/$defs/locator"
            }
          }
        }
      }
    }
  }
}
