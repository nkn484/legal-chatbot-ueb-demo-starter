{
  "$id": "quality-retrieval-metrics.schema.json",
  "title": "Quality Retrieval A2 Measurement Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration", "aggregate_metrics", "case_metrics"],
  "properties": {
    "schema_version": {"const": "QUALITY-RETRIEVAL-METRICS-1"},
    "configuration": {"$ref": "#/$defs/configuration"},
    "aggregate_metrics": {"$ref": "#/$defs/aggregateMetrics"},
    "case_metrics": {"type": "array", "items": {"$ref": "#/$defs/caseMetrics"}}
  },
  "$defs": {
    "measuredNumber": {"type": ["number", "null"]},
    "ratio": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": ["integer", "null"], "minimum": 0}, "denominator": {"type": ["integer", "null"], "minimum": 0}}},
    "configuration": {"type": "object", "additionalProperties": false, "required": ["stable_id", "version", "profile_name", "pool_size", "evidence_min", "evidence_max", "reranker_setting", "repair_setting"], "properties": {"stable_id": {"type": "string", "pattern": "^QRRA2-(?:C0[1-8]|NR0[1-3])$"}, "version": {"const": "1"}, "profile_name": {"type": "string", "pattern": "^quality_retrieval_[a-z0-9_]+_v1$"}, "pool_size": {"type": "integer", "enum": [3, 8, 12, 16, 20]}, "evidence_min": {"type": "integer", "minimum": 3, "maximum": 6}, "evidence_max": {"type": "integer", "minimum": 3, "maximum": 6}, "reranker_setting": {"type": "string"}, "repair_setting": {"type": "string"}}},
    "dbCost": {"type": "object", "additionalProperties": false, "required": ["query_count", "lane_ms", "transaction_ms", "rows", "buffer_hits", "buffer_reads"], "properties": {"query_count": {"$ref": "#/$defs/measuredNumber"}, "lane_ms": {"$ref": "#/$defs/measuredNumber"}, "transaction_ms": {"$ref": "#/$defs/measuredNumber"}, "rows": {"$ref": "#/$defs/measuredNumber"}, "buffer_hits": {"$ref": "#/$defs/measuredNumber"}, "buffer_reads": {"$ref": "#/$defs/measuredNumber"}}},
    "aggregateMetrics": {"type": "object", "additionalProperties": false, "required": ["expected_recall_at_8", "expected_recall_at_20", "expected_recall_at_50", "final_expected_recall", "direct_title_hit", "lexical_expected_hit", "semantic_expected_hit", "source_coverage", "sub_intent_coverage", "wrong_doc_rate", "false_insufficient", "reranker_promoted_expected", "reranker_demoted_expected", "reranker_promoted_wrong", "reranker_demoted_wrong", "latency_p50_ms", "latency_p95_ms", "db_cost", "answer_grounded", "evidence_count", "candidate_to_final_loss", "invariant_failures"], "properties": {"expected_recall_at_8": {"$ref": "#/$defs/ratio"}, "expected_recall_at_20": {"$ref": "#/$defs/ratio"}, "expected_recall_at_50": {"$ref": "#/$defs/ratio"}, "final_expected_recall": {"$ref": "#/$defs/ratio"}, "direct_title_hit": {"$ref": "#/$defs/ratio"}, "lexical_expected_hit": {"$ref": "#/$defs/ratio"}, "semantic_expected_hit": {"$ref": "#/$defs/ratio"}, "source_coverage": {"$ref": "#/$defs/ratio"}, "sub_intent_coverage": {"$ref": "#/$defs/ratio"}, "wrong_doc_rate": {"$ref": "#/$defs/ratio"}, "false_insufficient": {"$ref": "#/$defs/ratio"}, "reranker_promoted_expected": {"$ref": "#/$defs/ratio"}, "reranker_demoted_expected": {"$ref": "#/$defs/ratio"}, "reranker_promoted_wrong": {"$ref": "#/$defs/ratio"}, "reranker_demoted_wrong": {"$ref": "#/$defs/ratio"}, "latency_p50_ms": {"$ref": "#/$defs/measuredNumber"}, "latency_p95_ms": {"$ref": "#/$defs/measuredNumber"}, "db_cost": {"$ref": "#/$defs/dbCost"}, "answer_grounded": {"$ref": "#/$defs/ratio"}, "evidence_count": {"$ref": "#/$defs/ratio"}, "candidate_to_final_loss": {"$ref": "#/$defs/ratio"}, "invariant_failures": {"type": "integer", "minimum": 0}}},
    "caseMetrics": {"type": "object", "additionalProperties": false, "required": ["case_id", "expected_recall_at_8", "expected_recall_at_20", "expected_recall_at_50", "final_expected_recall", "direct_title_hit", "lexical_expected_hit", "semantic_expected_hit", "source_coverage", "sub_intent_coverage", "wrong_doc_rate", "false_insufficient", "reranker_promoted_expected", "reranker_demoted_expected", "reranker_promoted_wrong", "reranker_demoted_wrong", "latency_ms", "db_cost", "answer_grounded", "evidence_count", "candidate_to_final_loss", "invariant_failures", "repair_trace"], "properties": {"case_id": {"type": "string", "pattern": "^(?:Q[0-9]{2}|B-Q[0-9]{2}-0[1-3]|C-[A-Z0-9-]+-[0-9]{2})$"}, "expected_recall_at_8": {"$ref": "#/$defs/ratio"}, "expected_recall_at_20": {"$ref": "#/$defs/ratio"}, "expected_recall_at_50": {"$ref": "#/$defs/ratio"}, "final_expected_recall": {"$ref": "#/$defs/ratio"}, "direct_title_hit": {"$ref": "#/$defs/ratio"}, "lexical_expected_hit": {"$ref": "#/$defs/ratio"}, "semantic_expected_hit": {"$ref": "#/$defs/ratio"}, "source_coverage": {"$ref": "#/$defs/ratio"}, "sub_intent_coverage": {"$ref": "#/$defs/ratio"}, "wrong_doc_rate": {"$ref": "#/$defs/ratio"}, "false_insufficient": {"$ref": "#/$defs/ratio"}, "reranker_promoted_expected": {"$ref": "#/$defs/ratio"}, "reranker_demoted_expected": {"$ref": "#/$defs/ratio"}, "reranker_promoted_wrong": {"$ref": "#/$defs/ratio"}, "reranker_demoted_wrong": {"$ref": "#/$defs/ratio"}, "latency_ms": {"$ref": "#/$defs/measuredNumber"}, "db_cost": {"$ref": "#/$defs/dbCost"}, "answer_grounded": {"type": ["boolean", "null"]}, "evidence_count": {"$ref": "#/$defs/measuredNumber"}, "candidate_to_final_loss": {"$ref": "#/$defs/ratio"}, "invariant_failures": {"type": "array", "items": {"type": "string"}}, "repair_trace": {"type": "object", "additionalProperties": false, "required": ["round_count", "unit_ids", "query_classes"], "properties": {"round_count": {"type": "integer", "minimum": 0, "maximum": 1}, "unit_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"}}, "query_classes": {"type": "array", "items": {"type": "string", "enum": ["NONE", "UNcovered_UNIT", "SOURCE_SCOPE", "TITLE_IDENTITY"]}}}}}}
  }
}
