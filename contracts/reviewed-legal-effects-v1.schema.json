{
  "title": "Reviewed Legal Effects Import Artifact v1",
  "description": "Approved artifact schema. It is default-off and does not authorize runtime enablement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_state",
    "artifact_id",
    "approval",
    "families",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "reviewed-legal-effects-v1"
    },
    "profile_state": {
      "const": "APPROVED_SCHEMA_DEFAULT_OFF"
    },
    "artifact_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/correction_event"
      }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
      "minLength": 1,
      "maxLength": 128
    },
    "external_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "safe_note": {
      "type": "string",
      "pattern": "^(?!.*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ww][Ww][Ww]\\.))[^\\u0000-\\u001F\\u007F-\\u009F]{1,500}$",
      "minLength": 1,
      "maxLength": 500
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "external_id",
        "snapshot_sha256",
        "normalized_text_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "enum": ["VBQPPL", "VNU", "UEB"]
        },
        "external_id": {
          "$ref": "#/$defs/external_id"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_text_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ARTICLE", "CLAUSE", "SECTION", "PAGE"]
        },
        "value": {
          "$ref": "#/$defs/safe_note"
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "provenance_id", "locator"],
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "provenance_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_by",
        "submitted_at",
        "reviewer_role",
        "reviewed_by",
        "reviewed_at",
        "approver_role",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "submitted_by": {
          "$ref": "#/$defs/opaque_id"
        },
        "submitted_at": {
          "$ref": "#/$defs/timestamp"
        },
        "reviewer_role": {
          "const": "LEGAL_REVIEWER"
        },
        "reviewed_by": {
          "$ref": "#/$defs/opaque_id"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "approver_role": {
          "const": "LEGAL_APPROVER"
        },
        "approved_by": {
          "$ref": "#/$defs/opaque_id"
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "completeness", "scope_note"],
      "properties": {
        "family_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "completeness": {
          "type": "string",
          "enum": ["DECLARED_PARTIAL", "DECLARED_COMPLETE"]
        },
        "scope_note": {
          "$ref": "#/$defs/safe_note"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "family_id",
        "subject",
        "object",
        "relation_kind",
        "effect_state",
        "basis"
      ],
      "properties": {
        "relation_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "family_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "subject": {
          "$ref": "#/$defs/endpoint"
        },
        "object": {
          "$ref": "#/$defs/endpoint"
        },
        "relation_kind": {
          "type": "string",
          "enum": ["IMPLEMENTS", "GOVERNS"]
        },
        "effect_state": {
          "const": "EFFECT_NOT_MODELED"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        }
      }
    },
    "correction_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "assertion_id", "kind", "reason_code", "reason_note"],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "assertion_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "kind": {
          "type": "string",
          "enum": ["CORRECTS", "REVOKES"]
        },
        "successor_relation_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "ENDPOINT_NOT_FOUND",
            "VERSION_HASH_MISMATCH",
            "PROVENANCE_NOT_FOUND",
            "LOCATOR_INVALID",
            "DUPLICATE_ASSERTION",
            "FAMILY_SCOPE_CONFLICT",
            "REVIEW_DISAGREEMENT",
            "SUPERSEDED_BY_REVIEW",
            "WITHDRAWN_BY_REVIEW"
          ]
        },
        "reason_note": {
          "$ref": "#/$defs/safe_note"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "CORRECTS"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["successor_relation_id"],
            "properties": {
              "successor_relation_id": {
                "$ref": "#/$defs/opaque_id"
              }
            }
          },
          "else": {
            "properties": {
              "successor_relation_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
